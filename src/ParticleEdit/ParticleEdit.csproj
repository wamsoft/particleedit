<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ParticleEdit</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    配布用。RID を指定して publish したときだけ効く。
      dotnet publish src/ParticleEdit -c Release -r win-x64
    実行ファイル 1 つ + wwwroot になる。ランタイムの同梱が要るので 100MB 前後。

    IncludeAllContentForSelfExtract が要る理由: EffekseerCore が
    Assembly.Location から自分の場所を求めており、素の単一ファイルだと
    これが空になって Core.Initialize が落ちる。自己展開にすると実体が
    ディスクに出るので通る。
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>none</DebugType>
    <!-- 上記のとおり承知のうえで単一ファイルにしているので黙らせる -->
    <NoWarn>$(NoWarn);IL3000</NoWarn>

    <!--
      配布物を「実行ファイル + wwwroot」だけにする。
      いずれも自前ホストで動かすぶんには要らない。
    -->
    <!-- IIS 用の設定ファイル -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!--
      事前圧縮 (.gz / .br) を作らない。
      配っているのは UseStaticFiles() なので圧縮済みのほうは配れず、
      置いてあっても使われないまま容量だけ増える。
    -->
    <CompressionEnabled>false</CompressionEnabled>
    <!-- 参照先 (EffekseerCore) の .pdb を持ってこない -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../third_party/EffekseerCore/EffekseerCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 型定義は読む人のために置いてあるだけで、実行には要らない -->
    <Content Remove="wwwroot/vendor/effekseer.d.ts" />
    <None Include="wwwroot/vendor/effekseer.d.ts" />
  </ItemGroup>

  <!--
    MapStaticAssets を使っていないので静的資材の対応表は要らない。
    SDK 側に出さないスイッチが無い (CopyStaticWebAssetsEndpointsManifest は
    ファイルがあれば無条件にコピーする) ので、publish の後に消す。
  -->
  <Target Name="RemoveStaticWebAssetsManifest" AfterTargets="Publish">
    <Delete Files="$(PublishDir)$(TargetName).staticwebassets.endpoints.json" />
  </Target>

</Project>
